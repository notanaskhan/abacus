{
  "name": "@abacus/api-client",
  "private": true,
  "type": "module",
  "description": "Generated from the backend's OpenAPI document (ADR-013). Do not edit src/ by hand: run `make generate`.",
  "scripts": {
    "generate": "openapi-ts",
    "build:types": "tsc -p . --noCheck"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/client.gen.d.ts",
      "default": "./src/client.gen.ts"
    },
    "./query": {
      "types": "./dist/@tanstack/react-query.gen.d.ts",
      "default": "./src/@tanstack/react-query.gen.ts"
    }
  }
}
