{
  // Declarations for consumers (dist/, gitignored; built by `make setup` and `make generate`).
  // Consumers type-check against these, not the sources, under the same strict flags as the web
  // app (exactOptionalPropertyTypes included). `--noCheck` (build:types): the generator's runtime
  // client internals don't satisfy that flag; they are generated by a pinned tool, not edited.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src"]
}
