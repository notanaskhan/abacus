{
  "$defs": {
    "BadgePart": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "cls": "internal",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "cls": "internal",
          "const": "badge",
          "title": "Kind",
          "type": "string"
        },
        "object": {
          "cls": "internal",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Object",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "object",
        "code"
      ],
      "title": "BadgePart",
      "type": "object"
    },
    "CiteListPart": {
      "additionalProperties": false,
      "properties": {
        "cites": {
          "cls": "internal",
          "items": {
            "$ref": "#/$defs/CiteSeg"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Cites",
          "type": "array"
        },
        "kind": {
          "cls": "internal",
          "const": "cite_list",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "cites"
      ],
      "title": "CiteListPart",
      "type": "object"
    },
    "CiteSeg": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "cls": "internal",
          "format": "uuid",
          "title": "Citation Id",
          "type": "string"
        },
        "kind": {
          "cls": "internal",
          "const": "cite",
          "title": "Kind",
          "type": "string"
        },
        "n": {
          "cls": "internal",
          "maximum": 999,
          "minimum": 1,
          "title": "N",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "citation_id",
        "n"
      ],
      "title": "CiteSeg",
      "type": "object"
    },
    "EntityRefPart": {
      "additionalProperties": false,
      "description": "A record by type and id; its label is rendered by code, never by the model.",
      "properties": {
        "kind": {
          "cls": "internal",
          "const": "entity_ref",
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "cls": "internal",
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "record_type": {
          "cls": "internal",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Record Type",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "record_type",
        "record_id"
      ],
      "title": "EntityRefPart",
      "type": "object"
    },
    "FactSeg": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "cls": "internal",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "cls": "internal",
          "const": "fact",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fact_id"
      ],
      "title": "FactSeg",
      "type": "object"
    },
    "FilePart": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "cls": "internal",
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "cls": "internal",
          "const": "file",
          "title": "Kind",
          "type": "string"
        },
        "meta": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "cls": "confidential",
          "default": null,
          "title": "Meta"
        },
        "name": {
          "cls": "confidential",
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "name"
      ],
      "title": "FilePart",
      "type": "object"
    },
    "KvPart": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "cls": "internal",
          "const": "kv",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "cls": "confidential",
          "items": {
            "$ref": "#/$defs/KvRow"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "rows"
      ],
      "title": "KvPart",
      "type": "object"
    },
    "KvRow": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "cls": "confidential",
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "cls": "confidential",
          "items": {
            "discriminator": {
              "mapping": {
                "cite": "#/$defs/CiteSeg",
                "fact": "#/$defs/FactSeg",
                "text": "#/$defs/TextSeg"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextSeg"
              },
              {
                "$ref": "#/$defs/CiteSeg"
              },
              {
                "$ref": "#/$defs/FactSeg"
              }
            ]
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Value",
          "type": "array"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "KvRow",
      "type": "object"
    },
    "MetricPart": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "cls": "internal",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "cls": "internal",
          "const": "metric",
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "cls": "confidential",
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "label",
        "fact_id"
      ],
      "title": "MetricPart",
      "type": "object"
    },
    "OptionRow": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "cls": "confidential",
          "default": null,
          "title": "Detail"
        },
        "key": {
          "cls": "internal",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Key",
          "type": "string"
        },
        "recommended": {
          "cls": "internal",
          "default": false,
          "title": "Recommended",
          "type": "boolean"
        },
        "title": {
          "cls": "confidential",
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "OptionRow",
      "type": "object"
    },
    "OptionsPart": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "cls": "internal",
          "const": "options",
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "cls": "confidential",
          "items": {
            "$ref": "#/$defs/OptionRow"
          },
          "maxItems": 9,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "options"
      ],
      "title": "OptionsPart",
      "type": "object"
    },
    "ParagraphPart": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "cls": "internal",
          "const": "p",
          "title": "Kind",
          "type": "string"
        },
        "segments": {
          "cls": "confidential",
          "items": {
            "discriminator": {
              "mapping": {
                "cite": "#/$defs/CiteSeg",
                "fact": "#/$defs/FactSeg",
                "text": "#/$defs/TextSeg"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/TextSeg"
              },
              {
                "$ref": "#/$defs/CiteSeg"
              },
              {
                "$ref": "#/$defs/FactSeg"
              }
            ]
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Segments",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "segments"
      ],
      "title": "ParagraphPart",
      "type": "object"
    },
    "TablePart": {
      "additionalProperties": false,
      "properties": {
        "head": {
          "cls": "confidential",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Head",
          "type": "array"
        },
        "kind": {
          "cls": "internal",
          "const": "table",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "cls": "confidential",
          "items": {
            "items": {
              "discriminator": {
                "mapping": {
                  "cite": "#/$defs/CiteSeg",
                  "fact": "#/$defs/FactSeg",
                  "text": "#/$defs/TextSeg"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/TextSeg"
                },
                {
                  "$ref": "#/$defs/CiteSeg"
                },
                {
                  "$ref": "#/$defs/FactSeg"
                }
              ]
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array"
          },
          "maxItems": 50,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "head",
        "rows"
      ],
      "title": "TablePart",
      "type": "object"
    },
    "TextSeg": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "cls": "internal",
          "const": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "cls": "confidential",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "TextSeg",
      "type": "object"
    }
  },
  "$id": "https://accrued.app/schemas/agent-blocks.v1.json",
  "additionalProperties": false,
  "description": "AgentBlocks v1: an ordered list of parts.",
  "properties": {
    "parts": {
      "cls": "confidential",
      "items": {
        "discriminator": {
          "mapping": {
            "badge": "#/$defs/BadgePart",
            "cite_list": "#/$defs/CiteListPart",
            "entity_ref": "#/$defs/EntityRefPart",
            "file": "#/$defs/FilePart",
            "kv": "#/$defs/KvPart",
            "metric": "#/$defs/MetricPart",
            "options": "#/$defs/OptionsPart",
            "p": "#/$defs/ParagraphPart",
            "table": "#/$defs/TablePart"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ParagraphPart"
          },
          {
            "$ref": "#/$defs/TablePart"
          },
          {
            "$ref": "#/$defs/KvPart"
          },
          {
            "$ref": "#/$defs/MetricPart"
          },
          {
            "$ref": "#/$defs/FilePart"
          },
          {
            "$ref": "#/$defs/BadgePart"
          },
          {
            "$ref": "#/$defs/CiteListPart"
          },
          {
            "$ref": "#/$defs/OptionsPart"
          },
          {
            "$ref": "#/$defs/EntityRefPart"
          }
        ]
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Parts",
      "type": "array"
    },
    "version": {
      "cls": "internal",
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "parts"
  ],
  "title": "AgentBlocks v1",
  "type": "object"
}
