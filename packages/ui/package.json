{
  "name": "@abacus/ui",
  "private": true,
  "type": "module",
  "description": "Design-system components (ADR-011): shadcn-style primitives on Radix, and AgentText for model output (ADR-065).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./fonts-doc.css": "./src/fonts-doc.css",
    "./theme.css": "./src/theme.css",
    "./root.css": "./src/root.css",
    "./base.css": "./src/base.css",
    "./motion.css": "./src/motion.css",
    "./utilities.css": "./src/utilities.css",
    "./contrast.css": "./src/contrast.css",
    "./tokens": "./src/tokens/tokens.ts",
    "./eslint-design-rules": "./eslint-design-rules.js",
    "./eslint-scope-rules": "./eslint-scope-rules.js",
    "./scope-guards.gen.json": "./scope-guards.gen.json",
    "./tokens/*": "./src/tokens/*",
    "./fonts/*": "./src/fonts/*",
    "./specimens": "./src/specimens/index.ts",
    "./graph": "./src/graph/index.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/portal-registry": "./src/icons/portal-registry.ts"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/gelasio": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extension-underline": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.77.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "test": "vitest run --environment jsdom",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  }
}
