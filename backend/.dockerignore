# The build context is this directory. Keep it to what the image needs: dependency files, code,
# migrations and (for the test target) tests. Never secrets, local state or caches: the
# repository is public (AGENTS.md rule 14).
.venv/
.local/
.evals/
.env
.env.*
**/secrets/
*.pem
*.key
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
mutants/
typings/
