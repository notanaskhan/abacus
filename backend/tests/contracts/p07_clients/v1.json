  "MaskedTinOut": {
    "description": "A taxpayer ID as every payload but the reveal carries it: kind and last four digits\n(`XX-XXX0287`, `\u2022\u2022\u2022-\u2022\u2022-2208`). Restricted; never in a list (ADR-031, P-12).",
    "properties": {
      "kind": {
        "cls": "internal",
        "enum": [
          "ssn",
          "ein",
          "itin"
        ],
        "title": "Kind",
        "type": "string"
      },
      "last4": {
        "anyOf": [
          {
            "pattern": "^[0-9]{4}$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "cls": "restricted",
        "title": "Last4",
        "x-pii-kind": "tin"
      },
      "presence": {
        "cls": "internal",
        "enum": [
          "on_file",
          "applied_for"
        ],
        "title": "Presence",
        "type": "string"
      }
    },
    "required": [
      "kind",
      "presence"
    ],
    "title": "MaskedTinOut",
    "type": "object"
  },
