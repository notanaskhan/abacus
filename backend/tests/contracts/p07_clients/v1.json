    "description": "The plain value, once, `Cache-Control: no-store`, for the 10-second reveal. The only\npayload that carries a TIN; one `tin.revealed` audit event names the reason, never the\nvalue (P-07 Story 1.3; DEC-141).",
    "properties": {
      "entity_id": {
        "cls": "internal",
        "format": "uuid",
        "title": "Entity Id",
        "type": "string"
      },
      "kind": {
