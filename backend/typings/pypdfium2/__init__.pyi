# The part of pypdfium2 that evidence previews and the word layer use (SPEC-029, TASK-056;
# P-03-T15 security review); it ships no stubs.
from collections.abc import Iterator, Sequence
from typing import BinaryIO

from PIL.Image import Image

class PdfiumError(RuntimeError): ...

class PdfBitmap:
    def to_pil(self) -> Image: ...

class PdfTextPage:
    def count_rects(self, index: int = ..., count: int = ...) -> int: ...
    def get_rect(self, index: int) -> tuple[float, float, float, float]: ...
    def get_text_bounded(
        self,
        left: float | None = ...,
        bottom: float | None = ...,
        right: float | None = ...,
        top: float | None = ...,
    ) -> str: ...
    def close(self) -> None: ...

class PdfObject:
    raw: object
    type: int
    level: int
    def get_bounds(self) -> tuple[float, float, float, float]: ...

class PdfPage:
    raw: object
    def get_size(self) -> tuple[float, float]: ...
    def get_bbox(self) -> tuple[float, float, float, float]: ...
    def get_rotation(self) -> int: ...
    def set_rotation(self, rotation: int) -> None: ...
    def render(self, *, scale: float = ..., draw_annots: bool = ...) -> PdfBitmap: ...
    def flatten(self) -> int: ...
    def get_textpage(self) -> PdfTextPage: ...
    def get_objects(
        self, filter: Sequence[int] | None = ..., max_depth: int = ...
    ) -> Iterator[PdfObject]: ...
    def close(self) -> None: ...

class PdfDocument:
    def __init__(self, input: bytes) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> PdfPage: ...
    def save(self, dest: BinaryIO) -> None: ...
    def close(self) -> None: ...
