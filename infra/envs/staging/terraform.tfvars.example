# Copy to terraform.tfvars (git-ignored) and fill in. Placeholders use the reserved .test suffix.
# Never commit real domains or account IDs: the repository is public.

# The neutral portal domain (F-09-T09). Must not contain the product name (ADR-163).
portal_base_domain = "portal-domain.example.test"

# Set only after its CNAME points at the default connection group (infra/README.md "Portal edge").
# portal_canary_custom_domain = "portal.canary-firm.example.test"

# From Q-01-T15's load balancer and VPC origin.
api_vpc_origin_id      = "vo_example"
api_origin_domain_name = "internal-api.staging.example.test"

# count for the first two weeks, then block.
portal_managed_rules_action = "count"

# Pen test read-only configuration review (DEC-306; infra/README.md "Pen-test review role").
# Set only for the test window, then set back to null and apply to remove the role.
# pentest_review_principal_arn = "arn:aws:iam::000000000000:role/tester-review"
# pentest_review_external_id   = "<from the vault, at least 32 characters>"
# pentest_review_starts_at     = "2027-02-15T14:00:00Z"
# pentest_review_ends_at       = "2027-03-05T23:00:00Z"

# Exports bucket task roles (DEC-454; infra/README.md "Exports bucket"). Set once Q-01-T15 creates
# the ECS task roles; until then the bucket's policies exist unattached.
# worker_task_role_name = "abacus-staging-worker-task"
# api_task_role_name    = "abacus-staging-api-task"

# Staging stack (Q-01-T14/T15; DEC-1003). Leave image_digest unset to plan only the data plane.
# shared_account_id    = "000000000000"
# image_digest         = "000000000000.dkr.ecr.us-east-2.amazonaws.com/abacus-backend@sha256:<64 hex>"
# ses_verified_address = "you@example.test"
# workos_issuer        = "https://api.workos.test/user_management/client_XXXX"
# workos_client_id     = "client_XXXX"
# workos_jwks          = "{\"keys\": [...]}"
# worker_task_role_name = "abacus-staging-worker"
# api_task_role_name    = "abacus-staging-api"
