{
  "name": "@abacus/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:portal": "tsc --noEmit && vite build --mode portal && node scripts/portal-dist-check.mjs dist/portal && node scripts/bundle-budget.mjs dist/portal",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "visual": "ABACUS_VISUAL=1 playwright test --project=visual",
    "visual:update": "ABACUS_VISUAL=1 playwright test --project=visual regression --update-snapshots=all",
    "visual:crop": "uv run --project ../../backend python -m abacus_tools.parity.crop_handoff \"$ACCRUED_HANDOFF_DIR\" \"$ACCRUED_BASELINES_SOURCE\"",
    "visual:baselines": "uv run --project ../../backend python -m abacus_tools.parity.baselines",
    "visual:ci": "node scripts/visual-ci.mjs",
    "parity:screens": "ABACUS_VISUAL=1 playwright test --project=parity-screens",
    "routes:seed": "node scripts/seed-manifest.mjs"
  },
  "dependencies": {
    "@abacus/api-client": "workspace:*",
    "@abacus/ui": "workspace:*",
    "@sentry/browser": "^11.11.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.13.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
