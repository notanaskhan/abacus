{
  "name": "@abacus/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "visual": "ABACUS_VISUAL=1 playwright test --project=visual",
    "visual:update": "ABACUS_VISUAL=1 playwright test --project=visual regression --update-snapshots=all",
    "visual:crop": "uv run --project ../../backend python -m abacus_tools.parity.crop_handoff \"$ACCRUED_HANDOFF_DIR\" \"$ACCRUED_BASELINES_SOURCE\"",
    "visual:baselines": "uv run --project ../../backend python -m abacus_tools.parity.baselines",
    "visual:ci": "node scripts/visual-ci.mjs"
  },
  "dependencies": {
    "@abacus/api-client": "workspace:*",
    "@abacus/ui": "workspace:*",
    "@sentry/browser": "^11.8.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
